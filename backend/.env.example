# Owner/migration connection — used only by db/seed_dictionary.js, NEVER by server.js
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sql_academy

# Readonly API connection — the only credential the running server holds.
# Must point at the sql_academy_readonly role created in db/init.sql.
READONLY_DATABASE_URL=postgres://sql_academy_readonly:change_me_in_env@localhost:5432/sql_academy

PORT=4000
CORS_ORIGIN=http://localhost:3000
